{
  "name": "website-view-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build ./src/server.ts --outdir ./dist --target bun",
    "start": "bun src/server.ts",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test --env-file .env.test --path-ignore-patterns=tests/browser.test.ts tests/unit.test.ts",
    "db:generate": "bun x prisma generate",
    "db:migrate": "bun x prisma migrate dev",
    "db:deploy": "bun x prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "config:check": "bun src/scripts/config-check.ts",
    "retention:cleanup": "bun src/jobs/retention.ts",
    "load:test": "bun scripts/load-test.ts",
    "test:browser": "playwright test tests/browser.test.ts",
    "test:all": "bun test --env-file .env.test --path-ignore-patterns=tests/browser.test.ts tests/unit.test.ts && playwright test tests/browser.test.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@prisma/client": "^6.14.0",
    "elysia": "^1.3.8",
    "ioredis": "^5.4.1",
    "jose": "^6.0.10",
    "ua-parser-js": "^2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bun": "latest",
    "@types/node": "latest",
    "playwright": "^1.62.1",
    "prisma": "^6.14.0",
    "typescript": "^5.9.2"
  }
  
}
