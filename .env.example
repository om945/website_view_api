# Required in production. Never commit the matching .env file.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://analytics:analytics@localhost:5432/analytics
REDIS_URL=redis://localhost:6379

# Google OAuth / OpenID Connect. Configure this exact callback URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/

# Generate independent random values of at least 32 characters for production.
SESSION_SECRET=change-this-development-session-secret
VISITOR_HASH_SECRET=change-this-development-visitor-secret

# Public API and dashboard origins. Production values must use HTTPS.
TRACKER_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
ALLOW_LOCALHOST_CORS_IN_PRODUCTION=false
TRUSTED_PROXY=false

# Session and rate limit settings.
SESSION_TTL=604800
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
DASHBOARD_RATE_LIMIT_MAX_REQUESTS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=30
PUBLIC_STATS_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_STATS_RATE_LIMIT_MAX_REQUESTS=60
MAX_REQUEST_BODY_BYTES=16384

# Retention is manual-only. Set true only when a scheduled cleanup invocation is configured.
DATA_RETENTION_DAYS=90
ENABLE_RETENTION_CLEANUP=false
